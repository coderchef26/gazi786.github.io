{
  "id": "projects",
  "type": "SharedSlice",
  "name": "Projects",
  "description": "Projects",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "project": {
          "type": "Group",
          "config": {
            "label": "Project",
            "repeat": true,
            "fields": {}
          }
        },
        "project_title": {
          "type": "Text",
          "config": {
            "label": "Project Name",
            "placeholder": "Project name"
          }
        },
        "project_slug": {
          "type": "Text",
          "config": {
            "label": "Project Slug",
            "placeholder": "URL slug"
          }
        },
        "project_tagline": {
          "type": "Text",
          "config": {
            "label": "Project Tagline",
            "placeholder": "Short one-liner description"
          }
        },
        "project_description": {
          "type": "StructuredText",
          "config": {
            "label": "Project Description",
            "placeholder": "Detailed description",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading5,heading6,strong,em,hyperlink,image,list-item,o-list-item,rtl"
          }
        },
        "project_status": {
          "type": "Select",
          "config": {
            "label": "Project Status",
            "placeholder": "",
