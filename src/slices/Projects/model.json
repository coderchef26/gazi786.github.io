{
  "id": "projects",
  "type": "SharedSlice",
  "name": "Projects",
  "description": "Projects",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Projects"
          }
        },
        "section_description": {
          "type": "Text",
          "config": {
            "label": "Section Description",
            "placeholder": "My portfolio of projects and work"
          }
        }
      },
      "items": {
        "project_title": {
          "type": "Text",
          "config": {
            "label": "Project Name",
            "placeholder": "Project name"
          }
        },
        "project_slug": {
          "type": "Text",
          "config": {
            "label": "Project Slug",
            "placeholder": "URL slug"
          }
        },
        "project_tagline": {
          "type": "Text",
          "config": {
            "label": "Project Tagline",
            "placeholder": "Short one-liner description"
          }
        },
        "project_description": {
          "type": "StructuredText",
          "config": {
            "label": "Project Description",
            "placeholder": "Detailed description",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading6,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "project_status": {
          "type": "Select",
          "config": {
            "label": "Project Status",
            "placeholder": "",
            "options": [
              "Completed",
              "In-progress",
              "Maintained",
              "Archived"
            ]
          }
        },
        "start_date": {
          "type": "Date",
          "config": {
            "label": "Start Date",
            "placeholder": ""
          }
        },
        "end_date": {
          "type": "Date",
          "config": {
            "label": "End Date",
            "placeholder": ""
          }
        },
        "featured_image": {
          "type": "Image",
          "config": {
            "label": "Featured Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "technologies_used": {
          "type": "Text",
          "config": {
            "label": "Technologies Used",
            "placeholder": "React, Node.js, MongoDB"
          }
        },
        "live_url": {
          "type": "Link",
          "config": {
            "label": "Live URL",
            "placeholder": "Live demo",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "github_url": {
          "type": "Link",
          "config": {
            "label": "GitHub URL",
            "placeholder": "Repository",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "client_name": {
          "type": "Text",
          "config": {
            "label": "Client Name",
            "placeholder": "Client or company name"
          }
        },
        "is_featured": {
          "type": "Boolean",
          "config": {
            "label": "Is Featured",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "display_order": {
          "type": "Number",
          "config": {
            "label": "Display Order",
            "placeholder": "Sort order"
          }
        },
        "color_scheme": {
          "type": "Select",
          "config": {
            "label": "Color Scheme",
            "placeholder": "",
            "options": [
              "Cyan",
              "Blue",
              "Purple",
              "Green"
            ]
          }
        }
      }
    }
  ]
}
