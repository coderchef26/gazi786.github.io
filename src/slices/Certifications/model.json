{
  "id": "certifications",
  "type": "SharedSlice",
  "name": "Certifications",
  "description": "Certifications",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Certifications"
          }
        },
        "section_description": {
          "type": "Text",
          "config": {
            "label": "Section Description",
            "placeholder": "Professional certifications and credentials"
          }
        }
      },
      "items": {
        "certification_name": {
          "type": "Text",
          "config": {
            "label": "Certification Name",
            "placeholder": "Name of the certification"
          }
        },
        "certification_logo": {
          "type": "Image",
          "config": {
            "label": "Certification Logo",
            "constraint": {},
            "thumbnails": []
          }
        },
        "issuing_organization": {
          "type": "Text",
          "config": {
            "label": "Issuing Organization",
            "placeholder": "Organization that issued the certification"
          }
        },
        "organization_website": {
          "type": "Link",
          "config": {
            "label": "Organization Website",
            "placeholder": "Issuer's website URL",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "certification_type": {
          "type": "Select",
          "config": {
            "label": "Certification Type",
            "placeholder": "",
            "options": [
              "Professional",
              "Technical",
              "Academic",
              "Industry",
              "Vendor-specific",
              "Government"
            ]
          }
        },
        "credential_id": {
          "type": "Text",
          "config": {
            "label": "Credential ID",
            "placeholder": "Certification ID or badge number"
          }
        },
        "issue_date": {
          "type": "Date",
          "config": {
            "label": "Issue Date",
            "placeholder": ""
          }
        },
        "expiry_date": {
          "type": "Date",
          "config": {
            "label": "Expiry Date",
            "placeholder": "Leave empty if no expiry"
          }
        },
        "never_expires": {
          "type": "Boolean",
          "config": {
            "label": "Never Expires",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "verification_url": {
          "type": "Link",
          "config": {
            "label": "Verification URL",
            "placeholder": "URL to verify the certification",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "badge_url": {
          "type": "Link",
          "config": {
            "label": "Badge URL",
            "placeholder": "URL to digital badge",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "certification_description": {
          "type": "StructuredText",
          "config": {
            "label": "Certification Description",
            "placeholder": "What this certification covers",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading6,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "skills_acquired": {
          "type": "Text",
          "config": {
            "label": "Skills Acquired",
            "placeholder": "Key skills gained from this certification"
          }
        },
        "difficulty_level": {
          "type": "Select",
          "config": {
            "label": "Difficulty Level",
            "placeholder": "",
            "options": [
              "Beginner",
              "Intermediate",
              "Advanced",
              "Expert",
              "Professional"
            ]
          }
        },
        "relevance_score": {
          "type": "Number",
          "config": {
            "label": "Relevance Score",
            "placeholder": "1-10 for AI prioritization"
          }
        }
      }
    }
  ]
}
