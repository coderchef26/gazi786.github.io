{
  "id": "skills",
  "type": "SharedSlice",
  "name": "Skills",
  "description": "Skills",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Skills"
          }
        },
        "section_description": {
          "type": "Text",
          "config": {
            "label": "Section Description",
            "placeholder": "Technologies and tools I work with"
          }
        }
      },
      "items": {
        "skill_name": {
          "type": "Text",
          "config": {
            "label": "Skill Name",
            "placeholder": "JavaScript"
          }
        },
        "skill_category": {
          "type": "Select",
          "config": {
            "label": "Skill Category",
            "placeholder": "",
            "options": [
              "Frontend",
              "Backend",
              "Database",
              "DevOps",
              "Tools",
              "Design",
              "Soft Skills"
            ]
          }
        },
        "skill_type": {
          "type": "Select",
          "config": {
            "label": "Skill Type",
            "placeholder": "",
            "options": [
              "Language",
              "Framework",
              "Library",
              "Tool",
              "Platform",
              "Methodology"
            ]
          }
        },
        "proficiency_level": {
          "type": "Select",
          "config": {
            "label": "Proficiency Level",
            "placeholder": "",
            "options": [
              "Beginner",
              "Intermediate",
              "Advanced",
              "Expert"
            ]
          }
        },
        "proficiency_percentage": {
          "type": "Number",
          "config": {
            "label": "Proficiency Percentage",
            "placeholder": "85"
          }
        },
        "years_experience": {
          "type": "Number",
          "config": {
            "label": "Years Experience",
            "placeholder": "3"
          }
        },
        "skill_icon": {
          "type": "Text",
          "config": {
            "label": "Skill Icon",
            "placeholder": "devicon-javascript-plain"
          }
        },
        "colour_hex": {
          "type": "Text",
          "config": {
            "label": "Colour Hex",
            "placeholder": "#F7DF1E"
          }
        },
        "is_featured": {
          "type": "Boolean",
          "config": {
            "label": "Is Featured",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "skill_description": {
          "type": "StructuredText",
          "config": {
            "label": "Skill Description",
            "placeholder": "What you can do with this skill",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "projects_count": {
          "type": "Number",
          "config": {
            "label": "Projects Count",
            "placeholder": "5"
          }
        },
        "certifications": {
          "type": "Text",
          "config": {
            "label": "Certifications",
            "placeholder": "Related certifications"
          }
        },
        "learning_status": {
          "type": "Select",
          "config": {
            "label": "Learning Status",
            "placeholder": "",
            "options": [
              "Proficient",
              "Currently Learning",
              "Want to Learn"
            ]
          }
        }
      }
    }
  ]
}
