{
  "id": "experience",
  "type": "SharedSlice",
  "name": "Experience",
  "description": "Experience",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Experience"
          }
        },
        "section_description": {
          "type": "Text",
          "config": {
            "label": "Section Description",
            "placeholder": "My professional experience and career journey"
          }
        }
      },
      "items": {
        "company_name": {
          "type": "Text",
          "config": {
            "label": "Company Name",
            "placeholder": "Employer name"
          }
        },
        "company_logo": {
          "type": "Image",
          "config": {
            "label": "Company Logo",
            "constraint": {},
            "thumbnails": []
          }
        },
        "company_website": {
          "type": "Link",
          "config": {
            "label": "Company Website",
            "placeholder": "Company URL",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "company_location": {
          "type": "Text",
          "config": {
            "label": "Company Location",
            "placeholder": "City, Country"
          }
        },
        "work_type": {
          "type": "Select",
          "config": {
            "label": "Work Type",
            "placeholder": "",
            "options": [
              "Full-time",
              "Part-time",
              "Self-employed",
              "Freelance",
              "Contract",
              "Internship",
              "Apprenticeship",
              "Volunteer"
            ]
          }
        },
        "work_model": {
          "type": "Select",
          "config": {
            "label": "Work Model",
            "placeholder": "",
            "options": [
              "Onsite",
              "Hybrid",
              "Remote"
            ]
          }
        },
        "job_title": {
          "type": "Text",
          "config": {
            "label": "Job Title",
            "placeholder": "Your position"
          }
        },
        "department": {
          "type": "Text",
          "config": {
            "label": "Department",
            "placeholder": "e.g., \"Engineering\", \"Product Development\""
          }
        },
        "seniority_level": {
          "type": "Select",
          "config": {
            "label": "Seniority Level",
            "placeholder": "",
            "options": [
              "Junior",
              "Mid-level (Intermediate)",
              "Senior",
              "Lead",
              "Principal",
              "Manager",
              "Director"
            ]
          }
        },
        "start_date": {
          "type": "Date",
          "config": {
            "label": "Start Date",
            "placeholder": ""
          }
        },
        "end_date": {
          "type": "Date",
          "config": {
            "label": "End Date",
            "placeholder": "Leave empty if current"
          }
        },
        "is_current": {
          "type": "Boolean",
          "config": {
            "label": "Currently Work Here",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "role_summary": {
          "type": "StructuredText",
          "config": {
            "label": "Role Summary",
            "placeholder": "Brief overview of the role",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading6,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "key_achievements": {
          "type": "StructuredText",
          "config": {
            "label": "Key Achievements",
            "placeholder": "Notable accomplishments in this role",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading6,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "projects_delivered": {
          "type": "Number",
          "config": {
            "label": "Projects Delivered",
            "placeholder": "Number of projects completed"
          }
        },
        "technologies_used": {
          "type": "Text",
          "config": {
            "label": "Technologies Used",
            "placeholder": "Key technologies and tools"
          }
        },
        "impact_score": {
          "type": "Number",
          "config": {
            "label": "Impact Score",
            "placeholder": "1-10 for AI prioritization"
          }
        }
      }
    }
  ]
}
