{
  "id": "experience",
  "type": "SharedSlice",
  "name": "Experience",
  "description": "Experience",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "company_name": {
          "type": "Text",
          "config": {
            "label": "Company Name",
            "placeholder": "Employer name"
          }
        },
        "company_logo": {
          "type": "Image",
          "config": {
            "label": "Company Logo",
            "constraint": {},
            "thumbnails": []
          }
        },
        "company_website": {
          "type": "Link",
          "config": {
            "label": "Company Website",
            "placeholder": "Company URL",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "company_location": {
          "type": "Text",
          "config": {
            "label": "Company Location",
            "placeholder": "City, Country"
          }
        },
        "work_type": {
          "type": "Select",
          "config": {
            "label": "Work Type",
            "placeholder": "",
            "options": [
              "Full-time",
              "Part-time",
              "Self-employed",
              "Freelance",
              "Contract",
              "Internship",
              "Apprenticeship",
              "Volunteer"
            ]
          }
        },
        "work_model": {
          "type": "Select",
          "config": {
            "label": "Work Model",
            "placeholder": "",
            "options": [
              "Onsite",
              "Hybrid",
              "Remote"
            ]
          }
        },
        "job_title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": "Your position"
          }
        },
        "department": {
          "type": "Text",
          "config": {
            "label": "Department",
            "placeholder": "e.g., \"Engineering\", \"Product Development\""
          }
        },
        "seniority_level": {
          "type": "Select",
          "config": {
            "label": "Seniority Level",
            "placeholder": "",
            "options": [
              "Junior",
              "Mid-level (Intermediate)",
              "Senior",
              "Lead",
              "Principal",
              "Manager",
              "Director"
            ]
          }
        },
        "startdate": {
          "type": "Date",
          "config": {
            "label": "Start Date",
            "placeholder": ""
          }
        },
        "enddate": {
          "type": "Date",
          "config": {
            "label": "End Date",
            "placeholder": ""
          }
        },
        "is_current": {
          "type": "Boolean",
          "config": {
            "label": "Currently Work Here",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "role_summary": {
          "type": "StructuredText",
          "config": {
            "label": "Role Summary",
            "placeholder": "Brief overview of the role",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,list-item,o-list-item,rtl"
          }
        },
        "key_achievements": {
          "type": "Group",
          "config": {
            "label": "Key Achievements",
            "repeat": true,
            "fields": {
              "achievement_title": {
                "type": "Text",
                "config": {
                  "label": "Achievement Title",
                  "placeholder": ""
                }
              },
              "achievement_description": {
                "type": "StructuredText",
                "config": {
                  "label": "Achievement Description",
                  "placeholder": "",
                  "allowTargetBlank": true,
                  "multi": "paragraph,heading6,strong,em,hyperlink,list-item,o-list-item,rtl"
                }
              },
              "metric_value": {
                "type": "Text",
                "config": {
                  "label": "Metric Value",
                  "placeholder": "e.g., \"40% improvement\""
                }
              },
              "impact_area": {
                "type": "Select",
                "config": {
                  "label": "Impact Area",
                  "placeholder": "",
                  "options": [
                    "Revenue",
                    "Cost",
                    "Efficiency",
                    "Quality",
                    "User-experience"
                  ]
                }
              }
            }
          }
        },
        "projects_delivered": {
          "type": "Number",
          "config": {
            "label": "Projects Delivered",
            "placeholder": "Number of projects completed"
          }
        },
        "skills": {
          "type": "Link",
          "config": {
            "label": "Skills",
            "placeholder": "Link to skills page",
            "select": null,
            "allowTargetBlank": false,
            "allowText": true,
            "repeat": true
          }
        },
        "voice_summary": {
          "type": "Text",
          "config": {
            "label": "Voice Summary",
            "placeholder": "One-sentence role description"
          }
        },
        "role_keyowords": {
          "type": "Text",
          "config": {
            "label": "Role Keyowords",
            "placeholder": "For search/voice commands"
          }
        },
        "impact_score": {
          "type": "Number",
          "config": {
            "label": "Impact Score",
            "placeholder": "1-10 for AI prioritization"
          }
        }
      },
      "items": {}
    }
  ]
}